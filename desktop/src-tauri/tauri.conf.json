{
  "productName": "ContextDesk",
  "version": "0.1.2",
  "identifier": "cc.chriscase.contextdesk",
  "build": {
    "beforeDevCommand": "node scripts/gen-tauri-conf.mjs && npm run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "node scripts/gen-tauri-conf.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ContextDesk",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../../docs/help": "help",
      "../../AGENTS.md": "handbook/AGENTS.md",
      "../../docs/design": "handbook/docs/design",
      "../../docs/adr": "handbook/docs/adr",
      "../../docs/ARCHITECTURE.md": "handbook/docs/ARCHITECTURE.md",
      "../../docs/CLAIMS.md": "handbook/docs/CLAIMS.md",
      "../../docs/THREAT_MODEL.md": "handbook/docs/THREAT_MODEL.md",
      "../../docs/PROTOCOL.md": "handbook/docs/PROTOCOL.md",
      "../../docs/AGENT_WORKFLOW.md": "handbook/docs/AGENT_WORKFLOW.md",
      "../../docs/ISSUE_HONESTY.md": "handbook/docs/ISSUE_HONESTY.md",
      "../../docs/CLOSE_PROOF.md": "handbook/docs/CLOSE_PROOF.md",
      "../../fixtures/log-lab/acceptance/seven-day-25k/scenarios/behavior-scale/import": "demo-log-corpus/seven-day-25k"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4OThERjAzMUM1MThDMTMKUldRVGpGRWNBOStZeUd5YURIZXVlYnZBVE5GRUJVWExGK0R4QTE5L0pRNnRYZ1dJZnQ4YnFSc0gK",
      "endpoints": [
        "https://github.com/chriscase/ContextDesk/releases/latest/download/latest.json"
      ]
    }
  }
}
