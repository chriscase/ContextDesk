{
  "name": "contextdesk-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:port": "node scripts/dev-port.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/gen-tauri-conf.test.mjs ../scripts/check_help_corpus.test.mjs ../scripts/check_design_handbook.test.mjs ../scripts/check_public_media.test.mjs ../scripts/check_packaged_demo_manifest.test.mjs",
    "test:watch": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "vitest run --config vitest.visual.config.ts --update",
    "typecheck:visual": "tsc -p visual --noEmit",
    "preview": "vite preview",
    "gen:tauri-conf": "node scripts/gen-tauri-conf.mjs",
    "tauri": "node scripts/tauri-cli.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.62.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
