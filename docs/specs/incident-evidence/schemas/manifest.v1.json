{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdesk.local/schemas/incident_evidence/manifest.v1.json",
  "title": "ContextDesk Incident Evidence Bundle Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaId",
    "minReaderVersion",
    "bundleId",
    "createdAt",
    "producer",
    "privacy",
    "timeBasis",
    "components"
  ],
  "properties": {
    "schemaId": {
      "const": "contextdesk.incident_evidence.v1"
    },
    "minReaderVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "bundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:@+/-]+$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 64
    },
    "producer": {
      "$ref": "component.v1.json#/$defs/producer"
    },
    "privacy": {
      "$ref": "component.v1.json#/$defs/privacy"
    },
    "timeBasis": {
      "$ref": "component.v1.json#/$defs/timeBasis"
    },
    "components": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "items": {
        "$ref": "component.v1.json#/$defs/component"
      }
    }
  }
}
