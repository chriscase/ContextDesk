{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextdesk.local/schemas/incident_evidence/operational-metrics.v1.json",
  "title": "ContextDesk Operational Metrics Document v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "name", "series"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "propertyNames": { "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "collector": { "type": "string" },
        "query": { "type": "string" }
      }
    },
    "timeQuality": {
      "type": "string",
      "enum": ["wall", "mixed", "order_only"]
    },
    "point": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timestamp", "value"],
      "properties": {
        "timestamp": {
          "type": "number",
          "description": "Finite Unix timestamp in seconds; points in a series must be strictly increasing."
        },
        "value": { "type": "number" },
        "labels": { "$ref": "#/$defs/labels" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "timeQuality": { "$ref": "#/$defs/timeQuality" }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "value", "severity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "number" },
        "to": {
          "type": "number",
          "description": "Must be greater than from."
        },
        "reason": { "type": "string" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "unit",
        "points",
        "provenance",
        "timeQuality"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/point" }
        },
        "labels": { "$ref": "#/$defs/labels" },
        "thresholds": {
          "type": "array",
          "items": { "$ref": "#/$defs/threshold" }
        },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "timeQuality": { "$ref": "#/$defs/timeQuality" }
      }
    }
  }
}
