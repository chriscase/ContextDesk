# Frozen Log Lab text must regenerate byte-identically on every checkout.
fixtures/log-lab/** text eol=lf

# Preserve deliberately non-text fixture bytes.
fixtures/log-lab/**/*.zip -text -eol
fixtures/log-lab/**/04-crlf.log -text -eol whitespace=-trailing-space
fixtures/log-lab/**/binary.log -text -eol
# Retrieval-ablation malformed-UTF-8 probe: bytes must survive checkout.
fixtures/log-lab/**/malformed.log -text -eol

# Incident Evidence Bundle manifests hash exact payload bytes. Keep the frozen
# text fixtures LF-stable so validation is identical on Windows, macOS, Linux.
fixtures/incident-evidence/** text eol=lf
fixtures/incident-evidence/**/*.zip -text -eol

# SDK contract fixtures are byte-exact golden files. Keep their serialized
# representation stable across Windows, macOS, and Linux checkouts.
fixtures/contracts/** text eol=lf

# Shared cross-language parser catalogs are also byte-stable golden files, but
# remain outside exact generated fixture sets such as Log Lab and SDK contracts.
fixtures/citation-contracts/** text eol=lf
# Normalized-log fixtures are byte-stable: LF only, never CRLF.
# The fixture suite asserts this, so a checkout that rewrote line endings
# would fail the suite rather than silently changing the corpus.
fixtures/normalized-log-events/** text eol=lf

# Gateway diagnostic ledger fixtures include manifests that hash the exact
# report bytes. Keep their JSON byte-stable on Windows as well as Unix.
fixtures/gateway-cost-ledger/** text eol=lf

# Triage SDK v2 golden request/replay files are compared byte-for-byte.
# Keep their serialized JSON LF-stable on Windows as well as Unix.
fixtures/triage-sdk/** text eol=lf
