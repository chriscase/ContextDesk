{
  "name": "@cd-collab/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "npm run build && node dist/demo.js",
    "demo:static": "npm run build && node dist/demo-static.js",
    "qualify": "tsx src/qualification-cli.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/cli.ts up",
    "migrate:down": "tsx src/db/cli.ts down",
    "migrate:dry-run": "tsx src/db/cli.ts up --dry-run"
  },
  "dependencies": {
    "@cd-collab/contracts": "*",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "ldapts": "^9.0.0",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "eslint": "^9.22.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
