{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/log-workbench-search-request.v1.json",
  "title": "cd-collab Log Workbench Search Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "query",
    "mode",
    "filters",
    "contextBefore",
    "contextAfter",
    "cursor",
    "limit",
    "expectedNormalizationRevision"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.log_workbench_search_request.v1" },
    "query": { "type": "string", "maxLength": 512 },
    "mode": { "type": "string", "enum": ["literal", "case_insensitive", "regex"] },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includeTerms",
        "excludeTerms",
        "severity",
        "component",
        "file",
        "rotationFamily",
        "timeFrom",
        "timeTo",
        "evidenceIds"
      ],
      "properties": {
        "includeTerms": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
        "excludeTerms": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
        "severity": { "type": ["string", "null"] },
        "component": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "rotationFamily": { "type": ["string", "null"] },
        "timeFrom": { "type": ["string", "null"] },
        "timeTo": { "type": ["string", "null"] },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contextBefore": { "type": "integer", "minimum": 0, "maximum": 10 },
    "contextAfter": { "type": "integer", "minimum": 0, "maximum": 10 },
    "cursor": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "expectedNormalizationRevision": { "type": ["integer", "null"], "minimum": 0 }
  }
}
