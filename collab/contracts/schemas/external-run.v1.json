{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/external-run.v1.json",
  "title": "cd-collab External Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "id", "caseId", "contributionId", "sourceId", "outputHash", "outputText",
    "promptHash", "promptText", "promptCompleteness", "outputCompleteness", "workflowCompleteness",
    "evidenceVisibility", "snapshotBinding", "visibilityNote", "importerId", "importerUsername",
    "operatorId", "operatorUsername", "provider", "model", "version", "claimedTraces",
    "uncertainty", "timing", "cost", "redacted", "privacyClass", "corroborationState", "createdAt"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.external_run.v1" },
    "id": { "type": "string" },
    "caseId": { "type": "string" },
    "contributionId": { "type": "string" },
    "sourceId": { "type": "string" },
    "outputHash": { "type": "string" },
    "outputText": { "type": "string" },
    "promptHash": { "type": ["string", "null"] },
    "promptText": { "type": ["string", "null"] },
    "promptCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "outputCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "workflowCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "evidenceVisibility": { "type": "string", "enum": ["unknown", "importer_described"] },
    "snapshotBinding": { "type": ["string", "null"] },
    "visibilityNote": { "type": ["string", "null"] },
    "importerId": { "type": "string" },
    "importerUsername": { "type": "string" },
    "operatorId": { "type": "string" },
    "operatorUsername": { "type": "string" },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "claimedTraces": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": ["string", "null"] },
    "timing": { "type": ["string", "null"] },
    "cost": { "type": ["string", "null"] },
    "redacted": { "type": "boolean" },
    "privacyClass": { "type": "string", "enum": ["owner_only", "share_safe"] },
    "corroborationState": { "type": "string", "enum": ["unverified", "corroborated", "contradicted"] },
    "createdAt": { "type": "string" }
  }
}
