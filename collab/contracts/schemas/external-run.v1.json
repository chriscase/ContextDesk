{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/external-run.v1.json",
  "title": "cd-collab External Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId", "id", "caseId", "contributionId", "sourceId", "outputHash", "outputText",
    "promptHash", "promptText", "promptCompleteness", "outputCompleteness", "workflowCompleteness",
    "evidenceVisibility", "snapshotBinding", "visibilityNote", "importerId", "importerUsername",
    "operatorId", "operatorUsername", "provider", "model", "version", "claimedTraces",
    "uncertainty", "timing", "cost", "redacted", "privacyClass", "corroborationState", "createdAt"
  ],
  "dependentRequired": {
    "importMode": ["sourceRevision", "evidenceArtifactIds"],
    "sourceRevision": ["importMode", "evidenceArtifactIds"],
    "evidenceArtifactIds": ["importMode", "sourceRevision"]
  },
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.external_run.v1" },
    "id": { "type": "string" },
    "caseId": { "type": "string" },
    "contributionId": { "type": "string" },
    "sourceId": { "type": "string" },
    "outputHash": { "type": "string" },
    "outputText": { "type": "string" },
    "promptHash": { "type": ["string", "null"] },
    "promptText": { "type": ["string", "null"] },
    "promptCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "outputCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "workflowCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "evidenceVisibility": { "type": "string", "enum": ["unknown", "importer_described"] },
    "snapshotBinding": { "type": ["string", "null"] },
    "visibilityNote": { "type": ["string", "null"] },
    "importerId": { "type": "string" },
    "importerUsername": { "type": "string" },
    "operatorId": { "type": "string" },
    "operatorUsername": { "type": "string" },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "claimedTraces": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": ["string", "null"] },
    "timing": { "type": ["string", "null"] },
    "cost": { "type": ["string", "null"] },
    "redacted": { "type": "boolean" },
    "privacyClass": { "type": "string", "enum": ["owner_only", "share_safe"] },
    "corroborationState": { "type": "string", "enum": ["unverified", "corroborated", "contradicted"] },
    "createdAt": { "type": "string" },
    "importMode": { "type": "string", "const": "manual" },
    "sourceRevision": { "type": "integer", "minimum": 1 },
    "evidenceArtifactIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "importMode": true,
          "sourceRevision": true,
          "evidenceArtifactIds": true
        },
        "required": ["importMode", "sourceRevision", "evidenceArtifactIds"]
      },
      "then": { "$ref": "#/$defs/markedDurableManualImport" }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "markedDurableManualImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId", "id", "caseId", "contributionId", "sourceId", "outputHash", "outputText",
        "promptHash", "promptText", "promptCompleteness", "outputCompleteness", "workflowCompleteness",
        "evidenceVisibility", "snapshotBinding", "visibilityNote", "importerId", "importerUsername",
        "operatorId", "operatorUsername", "provider", "model", "version", "claimedTraces",
        "uncertainty", "timing", "cost", "redacted", "privacyClass", "corroborationState", "createdAt",
        "importMode", "sourceRevision", "evidenceArtifactIds"
      ],
      "properties": {
        "schemaId": { "type": "string", "const": "cd-collab.external_run.v1" },
        "id": { "$ref": "#/$defs/uuid" },
        "caseId": { "$ref": "#/$defs/uuid" },
        "contributionId": { "$ref": "#/$defs/uuid" },
        "sourceId": { "$ref": "#/$defs/uuid" },
        "outputHash": { "$ref": "#/$defs/sha256" },
        "outputText": { "type": "string", "minLength": 1, "maxLength": 1000000 },
        "promptHash": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "promptText": { "type": ["string", "null"], "maxLength": 1000000 },
        "promptCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
        "outputCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
        "workflowCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
        "evidenceVisibility": { "type": "string", "enum": ["unknown", "importer_described"] },
        "snapshotBinding": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "visibilityNote": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1000
        },
        "importerId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "importerUsername": { "type": "string", "minLength": 1, "maxLength": 200 },
        "operatorId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operatorUsername": { "type": "string", "minLength": 1, "maxLength": 200 },
        "provider": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "version": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "claimedTraces": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "uncertainty": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        },
        "timing": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "cost": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "redacted": { "type": "boolean" },
        "privacyClass": { "type": "string", "enum": ["owner_only", "share_safe"] },
        "corroborationState": { "type": "string", "const": "unverified" },
        "createdAt": { "type": "string", "format": "date-time", "minLength": 1 },
        "importMode": { "type": "string", "const": "manual" },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "evidenceArtifactIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "promptText": { "type": "null" } },
            "required": ["promptText"]
          },
          "then": {
            "properties": {
              "promptHash": { "type": "null" },
              "promptCompleteness": { "enum": ["partial", "unknown"] }
            }
          }
        },
        {
          "if": {
            "properties": { "promptText": { "type": "string" } },
            "required": ["promptText"]
          },
          "then": {
            "properties": { "promptHash": { "$ref": "#/$defs/sha256" } }
          }
        },
        {
          "if": {
            "properties": { "evidenceVisibility": { "const": "unknown" } },
            "required": ["evidenceVisibility"]
          },
          "then": {
            "properties": {
              "evidenceArtifactIds": { "type": "array", "maxItems": 0 },
              "snapshotBinding": { "type": "null" },
              "visibilityNote": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "evidenceVisibility": { "const": "importer_described" } },
            "required": ["evidenceVisibility"]
          },
          "then": {
            "anyOf": [
              {
                "properties": { "evidenceArtifactIds": { "type": "array", "minItems": 1 } },
                "required": ["evidenceArtifactIds"]
              },
              {
                "properties": { "snapshotBinding": { "type": "string" } },
                "required": ["snapshotBinding"]
              },
              {
                "properties": { "visibilityNote": { "type": "string", "minLength": 1 } },
                "required": ["visibilityNote"]
              }
            ]
          }
        }
      ]
    }
  }
}
