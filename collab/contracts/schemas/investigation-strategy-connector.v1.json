{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/investigation-strategy-connector.v1.json",
  "title": "cd-collab Investigation Strategy Connector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "connectorId",
    "version",
    "displayName",
    "executionMode",
    "supportedInputKinds",
    "requiredHostCapabilities",
    "egress",
    "privacyClass",
    "outputSchemaId",
    "traceSupport",
    "costSupport",
    "usageSupport",
    "cancellation"
  ],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "cd-collab.investigation_strategy_connector.v1"
    },
    "connectorId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "executionMode": {
      "type": "string",
      "enum": ["host_run", "external_import", "manual"]
    },
    "supportedInputKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "frozen_snapshot",
          "selected_evidence",
          "operator_question",
          "imported_run"
        ]
      }
    },
    "requiredHostCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "egress": {
      "type": "string",
      "enum": ["none", "host_local", "declared_provider"]
    },
    "privacyClass": {
      "type": "string",
      "enum": ["owner_only", "share_safe"]
    },
    "outputSchemaId": {
      "type": "string",
      "pattern": "^cd-collab\\.[a-z0-9._-]+\\.v[0-9]+$"
    },
    "traceSupport": {
      "type": "string",
      "enum": ["none", "optional", "required"]
    },
    "costSupport": {
      "type": "string",
      "enum": ["unknown_only", "observed"]
    },
    "usageSupport": {
      "type": "string",
      "enum": ["unknown_only", "observed"]
    },
    "cancellation": {
      "type": "string",
      "enum": ["none", "cooperative", "immediate"]
    }
  }
}
