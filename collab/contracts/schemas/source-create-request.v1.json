{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/source-create-request.v1.json",
  "title": "cd-collab Source Create Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "name",
    "kind",
    "description",
    "identityId",
    "expectedRevision",
    "idempotencyKey"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.source_create_request.v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": {
      "type": "string",
      "enum": ["human", "external-tool", "internal-system", "contextdesk", "unknown"]
    },
    "description": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 400
    },
    "identityId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512
    },
    "expectedRevision": { "type": "integer", "const": 0 },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    }
  }
}
