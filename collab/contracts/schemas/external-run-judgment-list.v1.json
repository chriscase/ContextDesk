{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/external-run-judgment-list.v1.json",
  "title": "cd-collab External Run Judgment List v1",
  "description": "Complete unpaged list. No cursor. JSON Schema cannot express contiguous seq starting at 1, nested record identity matching the envelope, or lookup of the stored ExternalRunV1 identified by runId; the parser enforces structural identity/sequence. Server/gateway binds list.runId to that stored run. The list envelope does not project sourceId or createdAt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "caseId", "runId", "judgments"],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.external_run_judgment_list.v1" },
    "caseId": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/uuid" },
    "judgments": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "judgment": {
      "type": "string",
      "enum": ["corroborates", "contradicts", "insufficient_evidence"]
    },
    "canonicalUtcMillisecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "Structural millisecond-Z form only. JSON Schema cannot express real calendar existence or leap-second rejection; requireCanonicalUtcInstant on the parser rejects nonexistent dates such as 2024-02-30T09:20:00.000Z and leap seconds such as 2016-12-31T23:59:60.000Z."
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque actor identity, not a UUID field. LDAP DN and operator-42 are valid. JSON Schema cannot express NFKC; the parser requires the value already be NFKC-normalized.",
      "allOf": [
        { "pattern": "^\\S(.*\\S)?$" },
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF]+$"
        }
      ]
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "JSON Schema cannot express NFKC or trim; schema-only validation is structural. The authoritative parser normalizes with NFKC and trim.",
      "allOf": [
        { "pattern": "\\S" },
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF]+$"
        }
      ]
    },
    "rationale": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4000,
      "description": "JSON Schema cannot express NFKC or trim; schema-only validation is structural. The authoritative parser normalizes with NFKC and trim. Ordinary newlines are allowed.",
      "allOf": [
        { "pattern": "\\S" },
        {
          "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2069\\uFEFF]+$"
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "username"],
      "properties": {
        "id": { "$ref": "#/$defs/actorId" },
        "username": { "$ref": "#/$defs/username" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["artifact", "contribution", "snapshot"] },
        "id": { "$ref": "#/$defs/uuid" }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Unique {kind,id} pairs, max 64. uniqueItems covers duplicates. Sorted canonical lexical order is parser-enforced because JSON Schema cannot compare cross-item order.",
      "items": { "$ref": "#/$defs/link" }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "caseId",
        "runId",
        "seq",
        "judgment",
        "actor",
        "links",
        "rationale",
        "recordedAt"
      ],
      "properties": {
        "schemaId": { "type": "string", "const": "cd-collab.external_run_judgment.v1" },
        "caseId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "seq": { "$ref": "#/$defs/seq" },
        "judgment": { "$ref": "#/$defs/judgment" },
        "actor": { "$ref": "#/$defs/actor" },
        "links": { "$ref": "#/$defs/links" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "recordedAt": { "$ref": "#/$defs/canonicalUtcMillisecond" }
      }
    }
  }
}
