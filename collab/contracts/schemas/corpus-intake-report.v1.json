{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/corpus-intake-report.v1.json",
  "title": "cd-collab Corpus Intake Preview Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "caseId",
    "origin",
    "previewToken",
    "accepted",
    "rejected",
    "limits"
  ],
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "cd-collab.corpus_intake_report.v1"
    },
    "caseId": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "files",
        "zip",
        "directory"
      ]
    },
    "previewToken": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "accepted": {
      "type": "array"
    },
    "rejected": {
      "type": "array"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRequestBytes",
        "maxArchiveBytes",
        "maxExpandedBytes",
        "maxCompressionRatio",
        "maxFileCount",
        "maxPathDepth",
        "maxArchiveDepth",
        "maxPathLength",
        "maxFileBytes",
        "maxProcessingMs",
        "maxExpansionMs",
        "maxLineBytes",
        "maxStructuredParseBytes",
        "supportedEncodings"
      ],
      "properties": {
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maxArchiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "maxExpandedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "maxCompressionRatio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxFileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxPathDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxArchiveDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxPathLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "maxProcessingMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maxExpansionMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "maxLineBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maxStructuredParseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "supportedEncodings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "utf-8",
              "us-ascii",
              "utf-8-lossy",
              "utf-16le",
              "utf-16be"
            ]
          }
        }
      }
    }
  }
}
