{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/source-list.v1.json",
  "title": "cd-collab Source List v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "sources"],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.source_list.v1" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "id",
        "name",
        "kind",
        "description",
        "lifecycle",
        "identityId",
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "schemaId": { "type": "string", "const": "cd-collab.source.v1" },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "type": "string",
          "enum": ["human", "external-tool", "internal-system", "contextdesk", "unknown"]
        },
        "description": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 400
        },
        "lifecycle": { "type": "string", "enum": ["active", "retired"] },
        "identityId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        },
        "createdAt": { "type": "string", "format": "date-time", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
