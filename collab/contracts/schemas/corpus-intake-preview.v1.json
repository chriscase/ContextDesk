{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/corpus-intake-preview.v1.json",
  "title": "cd-collab Corpus Intake Preview Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "origin", "sourceLabel", "privacyClass", "idempotencyKey", "files", "archiveBase64"],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.corpus_intake_preview.v1" },
    "origin": { "type": "string", "enum": ["files", "zip", "directory"] },
    "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 240 },
    "privacyClass": { "type": "string", "enum": ["owner_only", "share_safe"] },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "files": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "mediaType", "contentBase64"],
        "properties": {
          "relativePath": { "type": "string", "maxLength": 240 },
          "mediaType": { "type": "string", "maxLength": 128 },
          "contentBase64": { "type": "string", "maxLength": 89478488 }
        }
      }
    },
    "archiveBase64": { "type": ["string", "null"], "maxLength": 89478488 }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "zip" } }, "required": ["origin"] },
      "then": {
        "properties": {
          "files": { "type": "array", "maxItems": 0 },
          "archiveBase64": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "properties": {
          "files": { "type": "array", "minItems": 1 },
          "archiveBase64": { "type": "null" }
        }
      }
    }
  ]
}
