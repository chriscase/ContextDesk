{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/experiment-summary.v1.json",
  "title": "cd-collab Experiment Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "packageId",
    "privacyClass",
    "taskFingerprint",
    "snapshotFingerprint",
    "candidates",
    "agreement"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.experiment_summary.v1" },
    "packageId": { "type": "string" },
    "privacyClass": { "type": "string", "const": "share_safe" },
    "taskFingerprint": { "type": "string" },
    "snapshotFingerprint": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "experiment-package.v1.json#/$defs/candidate" }
    },
    "agreement": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "experiment-package.v1.json#/$defs/agreement" }
      ]
    }
  }
}
