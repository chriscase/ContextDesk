{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/external-run-import-request.v1.json",
  "title": "cd-collab External Run Import Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "importMode",
    "caseId",
    "sourceId",
    "expectedSourceRevision",
    "outputText",
    "promptText",
    "promptCompleteness",
    "outputCompleteness",
    "workflowCompleteness",
    "evidenceVisibility",
    "evidenceArtifactIds",
    "snapshotBinding",
    "visibilityNote",
    "operator",
    "provider",
    "model",
    "version",
    "claimedTraces",
    "uncertainty",
    "timing",
    "cost",
    "redacted",
    "privacyClass",
    "idempotencyKey"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.external_run_import_request.v1" },
    "importMode": { "type": "string", "const": "manual" },
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expectedSourceRevision": { "type": "integer", "minimum": 1 },
    "outputText": { "type": "string", "minLength": 1, "maxLength": 1000000 },
    "promptText": { "type": ["string", "null"], "maxLength": 1000000 },
    "promptCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "outputCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "workflowCompleteness": { "type": "string", "enum": ["exact", "partial", "unknown"] },
    "evidenceVisibility": { "type": "string", "enum": ["unknown", "importer_described"] },
    "evidenceArtifactIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "snapshotBinding": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "visibilityNote": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1000
    },
    "operator": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identityId", "username"],
          "properties": {
            "identityId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "username": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      ]
    },
    "provider": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "version": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "claimedTraces": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "uncertainty": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 4000
    },
    "timing": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "cost": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "redacted": { "type": "boolean" },
    "privacyClass": { "type": "string", "enum": ["owner_only", "share_safe"] },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "clientTime": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "promptText": { "type": "null" } },
        "required": ["promptText"]
      },
      "then": {
        "properties": {
          "promptCompleteness": { "enum": ["partial", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": { "evidenceVisibility": { "const": "unknown" } },
        "required": ["evidenceVisibility"]
      },
      "then": {
        "properties": {
          "evidenceArtifactIds": { "type": "array", "maxItems": 0 },
          "snapshotBinding": { "type": "null" },
          "visibilityNote": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "evidenceVisibility": { "const": "importer_described" } },
        "required": ["evidenceVisibility"]
      },
      "then": {
        "anyOf": [
          {
            "properties": { "evidenceArtifactIds": { "type": "array", "minItems": 1 } },
            "required": ["evidenceArtifactIds"]
          },
          {
            "properties": { "snapshotBinding": { "type": "string" } },
            "required": ["snapshotBinding"]
          },
          {
            "properties": { "visibilityNote": { "type": "string", "minLength": 1 } },
            "required": ["visibilityNote"]
          }
        ]
      }
    }
  ]
}
