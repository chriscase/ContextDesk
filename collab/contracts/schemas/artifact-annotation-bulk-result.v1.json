{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/artifact-annotation-bulk-result.v1.json",
  "title": "cd-collab Artifact Annotation Bulk Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "caseId", "items"],
  "properties": {
    "schemaId": { "const": "cd-collab.artifact_annotation_bulk_result.v1" },
    "caseId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "outcome", "annotation"],
            "properties": {
              "artifactId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
              "outcome": { "enum": ["created", "replayed"] },
              "annotation": { "$ref": "artifact-annotation.v1.json" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifactId", "outcome"],
            "properties": {
              "artifactId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
              "outcome": { "const": "not_found" }
            }
          }
        ]
      }
    }
  }
}
