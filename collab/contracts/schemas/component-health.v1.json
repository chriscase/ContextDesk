{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/component-health.v1.json",
  "title": "cd-collab ComponentHealthResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "generatedAt", "dataMode", "components", "notices"],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.component-health.v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "dataMode": { "type": "string", "enum": ["runtime", "synthetic_fixture"] },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/component" }
    },
    "notices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "Compatibility is shown only when an explicit check is reported; missing peers are not treated as compatible.",
          "Update state is informational. This panel never downloads or installs anything.",
          "Desktop, CLI, and host bridge identity is shown only when that component reports it."
        ]
      }
    }
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "storageMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "current", "target"],
      "properties": {
        "state": { "type": "string", "enum": ["current", "pending", "unknown", "not_applicable"] },
        "current": { "type": ["string", "null"], "minLength": 1 },
        "target": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "detail"],
      "properties": {
        "status": { "type": "string", "enum": ["compatible", "incompatible", "not_evaluated"] },
        "scope": { "type": "string", "enum": ["component_health_contract", "application_protocol", "not_evaluated"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "targetVersion"],
      "properties": {
        "state": { "type": "string", "enum": ["current", "available", "unknown", "not_configured"] },
        "targetVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source", "reportStatus", "version", "commit", "protocol", "storageMigration", "compatibility", "update"],
      "properties": {
        "id": { "type": "string", "enum": ["war_room_service", "desktop", "cli", "host_bridge"] },
        "label": { "type": "string", "enum": ["War Room service", "Desktop", "CLI", "Host bridge"] },
        "source": { "type": "string", "enum": ["runtime", "synthetic_fixture", "not_reported"] },
        "reportStatus": { "type": "string", "enum": ["reported", "not_reported"] },
        "version": { "type": ["string", "null"], "minLength": 1 },
        "commit": { "type": ["string", "null"], "minLength": 1 },
        "protocol": { "anyOf": [{ "$ref": "#/$defs/protocol" }, { "type": "null" }] },
        "storageMigration": { "$ref": "#/$defs/storageMigration" },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "update": { "$ref": "#/$defs/update" }
      }
    }
  }
}
