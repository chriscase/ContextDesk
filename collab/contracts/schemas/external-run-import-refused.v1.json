{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cd-collab.local/schemas/external-run-import-refused.v1.json",
  "title": "cd-collab External Run Import Refused v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "error",
    "importMode",
    "caseId",
    "sourceId",
    "expectedSourceRevision",
    "reason",
    "detail",
    "current"
  ],
  "properties": {
    "schemaId": { "type": "string", "const": "cd-collab.external_run_import_refused.v1" },
    "error": { "type": "string", "const": "external_run_import_refused" },
    "importMode": { "type": "string", "const": "manual" },
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "expectedSourceRevision": { "type": "integer", "minimum": 1 },
    "reason": {
      "type": "string",
      "enum": [
        "case_archived",
        "source_not_versioned",
        "source_retired",
        "source_revision_mismatch",
        "source_kind_not_importable",
        "privacy_mismatch",
        "idempotency_intent_mismatch"
      ]
    },
    "detail": { "type": "string", "minLength": 1, "maxLength": 600 },
    "current": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/source" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reason": { "const": "case_archived" } },
        "required": ["reason"]
      },
      "then": { "properties": { "current": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "reason": { "const": "privacy_mismatch" } },
        "required": ["reason"]
      },
      "then": { "properties": { "current": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "reason": { "const": "idempotency_intent_mismatch" } },
        "required": ["reason"]
      },
      "then": { "properties": { "current": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_not_versioned" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "current": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              { "not": { "type": "object", "required": ["revision"] } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_retired" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "current": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              {
                "type": "object",
                "required": ["revision"],
                "properties": { "lifecycle": { "const": "retired" } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_revision_mismatch" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "current": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              {
                "type": "object",
                "required": ["revision"],
                "properties": { "lifecycle": { "const": "active" } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_kind_not_importable" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "current": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              {
                "type": "object",
                "required": ["revision"],
                "properties": {
                  "lifecycle": { "const": "active" },
                  "kind": { "enum": ["human", "contextdesk"] }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "id",
        "name",
        "kind",
        "description",
        "lifecycle",
        "identityId",
        "createdAt",
        "createdBy"
      ],
      "properties": {
        "schemaId": { "type": "string", "const": "cd-collab.source.v1" },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": {
          "type": "string",
          "enum": ["human", "external-tool", "internal-system", "contextdesk", "unknown"]
        },
        "description": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 400
        },
        "lifecycle": { "type": "string", "enum": ["active", "retired"] },
        "identityId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512
        },
        "createdAt": { "type": "string", "format": "date-time", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 512 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
