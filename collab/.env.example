# Local process env (gitignored as .env). Secret-bearing values are
# secret-store-sourced — do not commit real credentials.

# secret-store-sourced
COLLAB_DATABASE_URL=postgres://collab_app:replace-from-secret-store@127.0.0.1:5432/collab
# secret-store-sourced
COLLAB_MIGRATE_DATABASE_URL=postgres://collab_migrator:replace-from-secret-store@127.0.0.1:5432/collab

COLLAB_HOST=127.0.0.1
COLLAB_PORT=8787
COLLAB_SERVICE_NAME=cd-collab
COLLAB_STORAGE=postgres
COLLAB_EVIDENCE_ROOT=.data/evidence
COLLAB_STATIC_DIR=web/dist
COLLAB_AUTH_MODE=ldap
COLLAB_COOKIE_SECURE=0
# Ingress hops to trust for the client address, which keys the login rate
# limiter and every audit origin. Unset means "no proxy" (the socket peer is
# the client). Behind a TLS-terminating reverse proxy set the hop count, or
# list the proxy addresses/CIDRs. Trusting every forwarded address is refused.
# COLLAB_TRUST_PROXY=1
# COLLAB_TRUST_PROXY=127.0.0.1,10.0.0.0/8

# Encrypted directory only (ldaps:// or ldap:// + COLLAB_LDAP_STARTTLS=1).
COLLAB_LDAP_URL=ldaps://directory.example.test:636
# COLLAB_LDAP_STARTTLS=1
COLLAB_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=test
COLLAB_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=test
# Directory trust anchors as PEM *content*, not a path. Setting this REPLACES
# the system trust store for the directory connection. To add an internal CA
# to system trust instead, leave it unset and start Node with
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/company-root.pem.
# COLLAB_LDAP_CA="$(cat /etc/ssl/certs/company-root.pem)"
# Per-operation directory timeout, 100..30000 ms (default 8000).
# COLLAB_LDAP_TIMEOUT_MS=8000
# Optional AD-compatible resolution. UPN suffix and NetBIOS are never derived from a DN.
# COLLAB_LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=test
# COLLAB_LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})
# COLLAB_LDAP_USER_RESOLUTION=service_bind_search,upn,domain_backslash
# COLLAB_LDAP_UPN_SUFFIX=example.test
# COLLAB_LDAP_NETBIOS_DOMAIN=EXAMPLE
# COLLAB_LDAP_MEMBER_ATTR=memberOf
# COLLAB_LDAP_ATTR_DISPLAY_NAME=cn
# COLLAB_LDAP_ATTR_EMAIL=mail
# COLLAB_LDAP_ATTR_ROLE_TITLE=title
# COLLAB_LDAP_ATTR_TEAM=departmentNumber
# secret-store-sourced — optional service-bind for group search
# COLLAB_LDAP_BIND_DN=
# COLLAB_LDAP_BIND_PASSWORD=replace-from-secret-store
# COLLAB_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap-bind
# Exactly one of BIND_PASSWORD / _FILE / _REF. _REF must be an absolute
# file: path (a relative one would resolve against the server process CWD,
# which differs between a unit file, a container, and a shell).
# COLLAB_LDAP_BIND_PASSWORD_REF=file:/run/secrets/ldap-bind
# Optional 32-byte base64url secret for stable opaque public user ids. Omit to
# create an owner-only key in COLLAB_EVIDENCE_ROOT (0600 on Unix; protect the
# evidence root with an owner-only host ACL on Windows). Replicas must share one.
# COLLAB_PUBLIC_IDENTITY_KEY=
COLLAB_GROUP_ROLE_MAP=cn=viewers,ou=groups,dc=example,dc=test=viewer;cn=contributors,ou=groups,dc=example,dc=test=contributor;cn=admins,ou=groups,dc=example,dc=test=admin

# Local-account fallback for a private/local deployment only. Passwords live in
# the process environment, so treat them as secret-store-sourced and add each
# group to COLLAB_GROUP_ROLE_MAP (for example local:case-lead=case-lead).
# COLLAB_AUTH_MODE=local
# COLLAB_LOCAL_USERS='[{"username":"lead","password":"replace-from-secret-store","displayName":"Case Lead","groups":["local:case-lead"]}]'

# Optional ContextDesk host bridge (filesystem path only; doctor does not execute it).
# COLLAB_BRIDGE_BIN=
# Optional bridge overrides: COLLAB_BRIDGE_LIBRARY, COLLAB_BRIDGE_DATA_DIR,
# COLLAB_BRIDGE_TIMEOUT_MS. COLLAB_TRIAGE_* remains supported for legacy hosts.

# Optional share-safe live profile catalog (syntax only; providers are never contacted by doctor).
# COLLAB_LIVE_PROFILE_CATALOG=./live-qualification-catalog.json
# COLLAB_PROFILE_CATALOG=
# COLLAB_LIVE_PROFILES=gpt-oss-120b,qwen-3.6-27b,ministral-3-14b-instruct-2512
# COLLAB_LIVE_VERCEL=0
