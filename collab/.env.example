# Local process env (gitignored as .env). Secret-bearing values are
# secret-store-sourced — do not commit real credentials.

# secret-store-sourced
COLLAB_DATABASE_URL=postgres://collab_app:replace-from-secret-store@127.0.0.1:5432/collab
# secret-store-sourced
COLLAB_MIGRATE_DATABASE_URL=postgres://collab_migrator:replace-from-secret-store@127.0.0.1:5432/collab

COLLAB_HOST=127.0.0.1
COLLAB_PORT=8787
COLLAB_SERVICE_NAME=cd-collab
COLLAB_EVIDENCE_ROOT=.data/evidence
