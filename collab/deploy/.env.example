# Copy to deploy/.env (gitignored). Values marked secret-store-sourced
# must come from the operator secret store — never commit real credentials.
# Hostnames here are generic compose service names, not employer systems.

# secret-store-sourced — bootstrap superuser for the example database only.
# The running app does not use this role.
POSTGRES_PASSWORD=replace-from-secret-store

# secret-store-sourced — least-privilege application role (DML, not superuser).
COLLAB_DATABASE_URL=postgres://collab_app:replace-from-secret-store@db:5432/collab

# secret-store-sourced — separate migrator role (DDL, not superuser).
COLLAB_MIGRATE_DATABASE_URL=postgres://collab_migrator:replace-from-secret-store@db:5432/collab

COLLAB_HOST=0.0.0.0
COLLAB_PORT=8787
COLLAB_SERVICE_NAME=cd-collab
COLLAB_EVIDENCE_ROOT=/var/lib/cd-collab/evidence
COLLAB_STATIC_DIR=/srv/web/dist
