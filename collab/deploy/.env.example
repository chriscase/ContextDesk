# Copy to deploy/.env (gitignored). Values marked secret-store-sourced
# must come from the operator secret store — never commit real credentials.
# Hostnames here are generic compose service names, not employer systems.

# secret-store-sourced — bootstrap superuser for the example database only.
# The running app does not use this role.
POSTGRES_PASSWORD=replace-from-secret-store

# secret-store-sourced — least-privilege application role (DML, not superuser).
COLLAB_DATABASE_URL=postgres://collab_app:replace-from-secret-store@db:5432/collab

# secret-store-sourced — separate migrator role (DDL, not superuser).
COLLAB_MIGRATE_DATABASE_URL=postgres://collab_migrator:replace-from-secret-store@db:5432/collab

COLLAB_HOST=0.0.0.0
COLLAB_PORT=8787
COLLAB_SERVICE_NAME=cd-collab
# Storage defaults to PostgreSQL. For a private/local single-node War Room,
# set COLLAB_STORAGE=sqlite and provide a writable path. SQLite does not offer
# PostgreSQL role separation or multi-worker HA.
# COLLAB_STORAGE=sqlite
# COLLAB_SQLITE_PATH=/var/lib/cd-collab/collab.sqlite
COLLAB_EVIDENCE_ROOT=/var/lib/cd-collab/evidence
COLLAB_STATIC_DIR=/srv/web/dist
COLLAB_COOKIE_SECURE=1
# This service does not terminate TLS: the ingress does, then forwards HTTP.
# That makes the socket peer the proxy for every request, so declare the
# ingress here or the login rate limiter buckets the whole workspace together
# and every audit origin records the proxy. Set the hop count between this
# service and the client, or list the proxy addresses/CIDRs. Trusting every
# forwarded address is refused: it would let any client pick its own bucket.
# COLLAB_TRUST_PROXY=1
# COLLAB_TRUST_PROXY=10.0.0.0/8
# Authentication defaults to LDAP. For a private/local deployment only, set
# COLLAB_AUTH_MODE=local and provide a JSON array of users. Do not use local
# auth as an internet-facing replacement for LDAP/SSO.
# COLLAB_AUTH_MODE=local
# COLLAB_LOCAL_USERS='[{"username":"lead","password":"replace-me","displayName":"Case Lead","groups":["local:case-lead"]}]'
# Optional host-owned Rust bridge executable for live gateway triage runs.
# The browser, database, and collab process never receive provider credentials.
# COLLAB_TRIAGE_RUNNER=/usr/local/bin/contextdesk
# COLLAB_TRIAGE_RUNNER_DATA_DIR=/var/lib/cd-host
# COLLAB_TRIAGE_LIBRARY=/var/lib/cd-bench
# COLLAB_TRIAGE_RUNNER_TIMEOUT_MS=300000
# Optional stable worker identity for durable multi-instance triage leases.
# If omitted, the process generates an ephemeral identity. Do not reuse the
# same value for two live workers.
# COLLAB_TRIAGE_WORKER_ID=collab-worker-1
# Optional safe labels for host-owned profiles shown in the War-Room.
# Credentials and endpoints are never placed here or returned to the browser.
# COLLAB_TRIAGE_PROFILE_CATALOG='[{"id":"profile:employer","label":"Employer gateway","provider":"openai-compatible"}]'

# Encrypted directory only. Plaintext ldap:// without StartTLS refuses to boot.
COLLAB_LDAP_URL=ldaps://directory.example.test:636
# COLLAB_LDAP_STARTTLS=1
COLLAB_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=test
COLLAB_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=test
# Directory trust anchors as PEM *content*, not a path — a path is refused at
# startup because Node would load it as an empty trust store. Setting this
# REPLACES the system trust store for the directory connection; to add an
# internal CA to system trust instead, leave it unset and start Node with
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/company-root.pem.
# COLLAB_LDAP_CA="$(cat /etc/ssl/certs/company-root.pem)"
# Per-operation directory timeout, 100..30000 ms (default 8000). There is no
# automatic retry: a failed directory operation fails the request.
# COLLAB_LDAP_TIMEOUT_MS=8000
# Optional AD-compatible resolution. UPN suffix and NetBIOS are never derived from a DN.
# COLLAB_LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=test
# COLLAB_LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})
# COLLAB_LDAP_USER_RESOLUTION=service_bind_search,upn,domain_backslash
# COLLAB_LDAP_UPN_SUFFIX=example.test
# COLLAB_LDAP_NETBIOS_DOMAIN=EXAMPLE
# COLLAB_LDAP_MEMBER_ATTR=memberOf
# COLLAB_LDAP_ATTR_DISPLAY_NAME=cn
# COLLAB_LDAP_ATTR_EMAIL=mail
# COLLAB_LDAP_ATTR_ROLE_TITLE=title
# COLLAB_LDAP_ATTR_TEAM=departmentNumber
# secret-store-sourced — optional service-bind (user DN search and group lookup
# after a successful user bind; needed when the directory hides group OUs)
# COLLAB_LDAP_BIND_DN=
# COLLAB_LDAP_BIND_PASSWORD=replace-from-secret-store
# COLLAB_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap-bind
# Exactly one of BIND_PASSWORD / _FILE / _REF. _REF must be an absolute
# file: path (a relative one would resolve against the server process CWD,
# which differs between a unit file, a container, and a shell).
# COLLAB_LDAP_BIND_PASSWORD_REF=file:/run/secrets/ldap-bind
# Optional 32-byte base64url secret for stable opaque public user ids. Omit to
# create an owner-only key in COLLAB_EVIDENCE_ROOT (0600 on Unix; protect the
# evidence root with an owner-only host ACL on Windows). Replicas must share one.
# COLLAB_PUBLIC_IDENTITY_KEY=
COLLAB_GROUP_ROLE_MAP=cn=viewers,ou=groups,dc=example,dc=test=viewer;cn=contributors,ou=groups,dc=example,dc=test=contributor;cn=admins,ou=groups,dc=example,dc=test=admin
# When local auth is enabled, add its groups to the same role map, for example:
# local:case-lead=case-lead

# Optional S3-compatible evidence bytes. Server-side only; doctor does not
# contact the bucket. Filesystem remains the default. COLLAB_EVIDENCE_ROOT
# stays the local control-state root in either mode.
# The object-store role must allow DeleteObject for staging and rollback cleanup.
# COLLAB_EVIDENCE_PROVIDER=s3
# COLLAB_EVIDENCE_S3_ENDPOINT=https://s3.example.test
# COLLAB_EVIDENCE_S3_REGION=garage
# COLLAB_EVIDENCE_S3_BUCKET=war-room-evidence
# COLLAB_EVIDENCE_S3_PREFIX=assigned-prefix
# COLLAB_EVIDENCE_S3_FORCE_PATH_STYLE=1
# COLLAB_EVIDENCE_S3_ALLOW_HTTP=0
# COLLAB_EVIDENCE_S3_CA_FILE=/etc/ssl/certs/s3-internal-ca.pem
# COLLAB_EVIDENCE_S3_TIMEOUT_MS=30000
# COLLAB_EVIDENCE_MAX_UPLOAD_BYTES=536870912
# COLLAB_EVIDENCE_S3_CREDENTIALS_MODE=static
# Exactly one source per credential: environment value, _FILE, or absolute
# file: reference. secret-store-sourced — mount owner-only files.
# COLLAB_EVIDENCE_S3_ACCESS_KEY_ID_FILE=/run/secrets/evidence-s3-access-key-id
# COLLAB_EVIDENCE_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/evidence-s3-secret-access-key
# COLLAB_EVIDENCE_S3_SESSION_TOKEN_FILE=/run/secrets/evidence-s3-session-token
# COLLAB_EVIDENCE_S3_ACCESS_KEY_ID_REF=file:/run/secrets/evidence-s3-access-key-id
# COLLAB_EVIDENCE_S3_SECRET_ACCESS_KEY_REF=file:/run/secrets/evidence-s3-secret-access-key

# Admin-owned share_safe redaction map (identity or username → shared label).
# Never embedded in share_safe export output.
# COLLAB_EXPORT_REDACTION_MAP=uid=alice,ou=people,dc=example,dc=test=contributor;alice=contributor
# COLLAB_EXPORT_INTERNAL_HOST_SUFFIXES=.internal.example.test,.corp.example.test
