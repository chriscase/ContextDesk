{
  "name": "@cd-collab/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser smoke and regression suite for the collab case-memory shell (war-room qualification).",
  "scripts": {
    "scenarios:check": "node --import tsx/esm src/war-room/matrix.ts --check",
    "scenarios:matrix": "node --import tsx/esm src/war-room/matrix.ts",
    "serve:fixture": "node --import tsx/esm src/serve-fixture.ts",
    "test": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "playwright": "^1.55.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2"
  }
}
